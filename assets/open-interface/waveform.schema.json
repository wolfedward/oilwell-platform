{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/owp-wave/1.0/waveform.schema.json",
  "title": "OWP-WAVE/1.0 structural wire schema; validate exact bytes with validate_waveform.py",
  "oneOf": [{"$ref": "#/$defs/manifest"}, {"$ref": "#/$defs/chunk"}],
  "$defs": {
    "name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "uuid": {"type": "string", "minLength": 36, "maxLength": 36, "pattern": "^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$"},
    "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
    "i64": {"type": "string", "minLength": 1, "maxLength": 20, "pattern": "^(0|-[1-9][0-9]*|[1-9][0-9]*)$"},
    "nonnegativeI64": {"type": "string", "minLength": 1, "maxLength": 19, "pattern": "^(0|[1-9][0-9]*)$"},
    "count": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "positiveCount": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "text": {"type": "string", "minLength": 1, "maxLength": 128},
    "utc": {"type": "string", "minLength": 27, "maxLength": 27, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"},
    "common": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "kind", "gateway_id", "device_id", "capture_id"],
      "properties": {
        "schema": {"type": "string", "const": "OWP-WAVE/1.0"}, "kind": {"type": "string", "enum": ["manifest", "chunk"]},
        "gateway_id": {"$ref": "#/$defs/name"}, "device_id": {"$ref": "#/$defs/name"},
        "capture_id": {"$ref": "#/$defs/uuid"}
      }
    },
    "channel": {
      "type": "object", "additionalProperties": false,
      "required": ["channel_id", "quantity", "unit", "encoding", "measurement_source", "signal_kind", "config_id", "calibration_id"],
      "properties": {
        "channel_id": {"$ref": "#/$defs/name"}, "quantity": {"$ref": "#/$defs/text"},
        "unit": {"type": "string", "minLength": 1, "maxLength": 32},
        "encoding": {"type": "string", "enum": ["i32le", "f32le"]},
        "measurement_source": {"type": "string", "enum": ["sensor", "derived", "synthetic", "unknown"]},
        "signal_kind": {"type": "string", "enum": ["instantaneous", "rms", "window_mean", "derived"]},
        "config_id": {"oneOf": [{"$ref": "#/$defs/name"}, {"type": "null"}]},
        "calibration_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["gateway_id", "device_id", "boot_id"],
      "properties": {"gateway_id": {"$ref": "#/$defs/name"}, "device_id": {"$ref": "#/$defs/name"}, "boot_id": {"$ref": "#/$defs/uuid"}}
    },
    "stream": {
      "type": "object", "additionalProperties": false,
      "required": ["stream_id", "source", "clock_domain_id", "rate_num", "rate_den", "first_sample_index", "offset_ns", "frame_count", "frame_bytes", "chunk_frames", "chunk_count", "decoded_bytes", "data_sha256", "channels"],
      "properties": {
        "stream_id": {"$ref": "#/$defs/name"}, "source": {"$ref": "#/$defs/source"},
        "clock_domain_id": {"$ref": "#/$defs/name"}, "rate_num": {"$ref": "#/$defs/positiveCount"},
        "rate_den": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "first_sample_index": {"$ref": "#/$defs/nonnegativeI64"}, "offset_ns": {"$ref": "#/$defs/i64"},
        "frame_count": {"$ref": "#/$defs/positiveCount"}, "frame_bytes": {"$ref": "#/$defs/positiveCount"},
        "chunk_frames": {"$ref": "#/$defs/positiveCount"}, "chunk_count": {"$ref": "#/$defs/positiveCount"},
        "decoded_bytes": {"$ref": "#/$defs/positiveCount"}, "data_sha256": {"$ref": "#/$defs/sha256"},
        "channels": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/channel"}}
      }
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["stream_id", "sample_index", "event"],
      "properties": {"stream_id": {"$ref": "#/$defs/name"}, "sample_index": {"oneOf": [{"$ref": "#/$defs/nonnegativeI64"}, {"type": "null"}]}, "event": {"type": "string", "enum": ["start", "turn", "end"]}}
    },
    "cycle": {
      "type": "object", "additionalProperties": false,
      "required": ["cycle_id", "start_ns", "turn_ns", "end_ns", "direction", "zero_reference", "reference_channel", "reference_events"],
      "properties": {
        "cycle_id": {"$ref": "#/$defs/uuid"}, "start_ns": {"$ref": "#/$defs/i64"},
        "turn_ns": {"$ref": "#/$defs/i64"}, "end_ns": {"$ref": "#/$defs/i64"},
        "direction": {"type": "string", "enum": ["clockwise", "counterclockwise", "unknown"]},
        "zero_reference": {"$ref": "#/$defs/text"}, "reference_channel": {"$ref": "#/$defs/name"},
        "reference_events": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/event"}}
      }
    },
    "manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "kind", "gateway_id", "device_id", "capture_id", "boot_id", "capture_kind", "source_kind", "producer", "source_evidence", "utc_start", "utc_uncertainty_ns", "clock_domain_id", "sync_evidence_id", "window_ns", "cycle", "streams"],
      "properties": {
        "schema": {"type": "string", "const": "OWP-WAVE/1.0"}, "kind": {"type": "string", "const": "manifest"},
        "gateway_id": {"$ref": "#/$defs/name"}, "device_id": {"$ref": "#/$defs/name"},
        "capture_id": {"$ref": "#/$defs/uuid"}, "boot_id": {"$ref": "#/$defs/uuid"},
        "capture_kind": {"type": "string", "enum": ["cycle", "event"]},
        "source_kind": {"type": "string", "enum": ["synthetic", "bench_measurement", "field_measurement", "unknown"]},
        "producer": {"type": "object", "additionalProperties": false, "required": ["manufacturer", "recorder_version"], "properties": {"manufacturer": {"$ref": "#/$defs/text"}, "recorder_version": {"$ref": "#/$defs/text"}}},
        "source_evidence": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
        "utc_start": {"oneOf": [{"$ref": "#/$defs/utc"}, {"type": "null"}]},
        "utc_uncertainty_ns": {"oneOf": [{"$ref": "#/$defs/nonnegativeI64"}, {"type": "null"}]},
        "clock_domain_id": {"$ref": "#/$defs/name"},
        "sync_evidence_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
        "window_ns": {"$ref": "#/$defs/nonnegativeI64"},
        "cycle": {"oneOf": [{"$ref": "#/$defs/cycle"}, {"type": "null"}]},
        "streams": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/stream"}}
      }
    },
    "chunk": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "kind", "gateway_id", "device_id", "capture_id", "stream_id", "chunk_index", "sample_start", "sample_count", "manifest_sha256", "data_sha256", "data_base64"],
      "properties": {
        "schema": {"type": "string", "const": "OWP-WAVE/1.0"}, "kind": {"type": "string", "const": "chunk"},
        "gateway_id": {"$ref": "#/$defs/name"}, "device_id": {"$ref": "#/$defs/name"},
        "capture_id": {"$ref": "#/$defs/uuid"}, "stream_id": {"$ref": "#/$defs/name"},
        "chunk_index": {"$ref": "#/$defs/count"}, "sample_start": {"$ref": "#/$defs/count"},
        "sample_count": {"$ref": "#/$defs/positiveCount"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"}, "data_sha256": {"$ref": "#/$defs/sha256"},
        "data_base64": {"type": "string", "minLength": 1, "maxLength": 174764, "contentEncoding": "base64"}
      }
    }
  }
}
