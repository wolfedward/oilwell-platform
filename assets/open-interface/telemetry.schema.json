{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oilwell:owp-edge:telemetry:1.0",
  "title": "OWP-EDGE/1.0 manufacturer telemetry profile",
  "$comment": "MIT. Schema checks shape only. Also run validate_telemetry.py for topic identity, byte limit, timestamp validity and sequence relations. Not a field-accuracy certification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "message_id", "gateway_id", "device_id", "boot_id", "created_at", "sequence", "samples"],
  "properties": {
    "schema": {"const": "oilwell.telemetry.v1"},
    "message_id": {"$ref": "#/$defs/identifier"},
    "gateway_id": {"$ref": "#/$defs/identifier"},
    "device_id": {"$ref": "#/$defs/identifier"},
    "boot_id": {"$ref": "#/$defs/identifier"},
    "created_at": {"$ref": "#/$defs/utc"},
    "sequence": {
      "type": "object", "additionalProperties": false, "required": ["first", "last"],
      "properties": {"first": {"$ref": "#/$defs/sequence"}, "last": {"$ref": "#/$defs/sequence"}}
    },
    "samples": {"type": "array", "minItems": 1, "maxItems": 5000, "items": {"$ref": "#/$defs/sample"}}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])", "maxLength": 128},
    "sequence": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "utc": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|\\+00:00)(?![\\s\\S])"},
    "sample": {
      "type": "object", "additionalProperties": false,
      "required": ["point", "measured_at", "sequence", "value", "quality", "unit", "source"],
      "properties": {
        "point": {"$ref": "#/$defs/identifier"}, "measured_at": {"$ref": "#/$defs/utc"},
        "sequence": {"$ref": "#/$defs/sequence"}, "value": {"type": "number"},
        "quality": {"enum": ["good", "uncertain", "bad"]},
        "unit": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[^\\u0000\\uD800-\\uDFFF]*(?![\\s\\S])"}]},
        "source": {"$ref": "#/$defs/identifier"}
      }
    }
  }
}
