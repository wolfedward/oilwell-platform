{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oilwell:OWP-INGEST-ACK:1.0",
  "title": "OWP-INGEST-ACK/1.0 application receipt",
  "description": "At most 4096 UTF-8 bytes. Duplicate keys, exact original payload hash, topic correlation and calendar validity require validate_ingest_ack.py; a JSON Schema alone is insufficient.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receipt_id", "gateway_id", "device_id", "message_id", "payload_sha256", "status", "reason_code", "recorded_at"],
  "properties": {
    "schema": {"type": "string", "const": "OWP-INGEST-ACK/1.0"},
    "receipt_id": {"type": "string", "minLength": 36, "maxLength": 36, "pattern": "^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$"},
    "gateway_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$", "not": {"pattern": "[\\r\\n]"}},
    "device_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$", "not": {"pattern": "[\\r\\n]"}},
    "message_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$", "not": {"pattern": "[\\r\\n]"}},
    "payload_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
    "status": {"type": "string", "enum": ["stored", "quarantined"]},
    "reason_code": {"type": "string"},
    "recorded_at": {"type": "string", "minLength": 27, "maxLength": 32, "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}(Z|\\+00:00)$", "not": {"pattern": "[\\r\\n]"}}
  },
  "oneOf": [
    {"properties": {"status": {"const": "stored"}, "reason_code": {"const": "accepted"}}},
    {"properties": {"status": {"const": "quarantined"}, "reason_code": {"enum": ["topic_invalid", "payload_too_large", "utf8_invalid", "json_invalid", "json_duplicate_key", "contract_invalid", "identity_mismatch", "idempotency_conflict", "qos_not_supported", "retained_publish"]}}}
  ]
}
